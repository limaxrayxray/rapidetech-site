---
// Données structurées Schema.org (JSON-LD), rendues dans le <head> du layout.
// - ProfessionalService (sous-type de LocalBusiness) sur TOUTES les pages :
//   le levier « map pack » local + la fiche d'identité que citent les IA.
//   Toutes les valeurs viennent de Directus (site_settings) — nom, description,
//   téléphone, courriel, villes desservies. Un champ vide est simplement omis
//   (jamais de placeholder dans le HTML public) : remplir site_settings.phone
//   et site_settings.email dans Directus pour qu'ils apparaissent.
// - FAQPage seulement quand des Q/R sont fournies (collection Directus `faq`
//   sur l'accueil, champ `faq` du service sur les pages services). Collection
//   absente → getFaq() retourne [] → aucun bloc émis, build OK.
// - `extra` : blocs propres à la page (ex. Service + BreadcrumbList sur les
//   pages services), qui référencent l'entreprise par son @id.
import type { SiteSettings, Service } from "@/lib/directus";
import { businessId } from "@/lib/schema";

interface Props {
  settings: SiteSettings;
  faq?: { question: string; answer: string }[];
  /** Services publiés → OfferCatalog (liens vers les pages dédiées). */
  services?: Pick<Service, "title" | "slug">[];
  /** Nom du fondateur (singleton about). */
  founder?: string;
  extra?: Record<string, unknown>[];
}

const { settings, faq = [], services = [], founder, extra = [] } = Astro.props;
const cities = settings.cities.map((c) => c.value);
const site = Astro.site!;
const sameAs = /^https?:\/\//.test(settings.google_reviews_url)
  ? [settings.google_reviews_url]
  : [];

const business = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": businessId(site),
  name: settings.company_name,
  description: settings.meta_description,
  url: site.href,
  logo: new URL("/branding/rapidetech-symbol-256.png", site).href,
  image: new URL("/og.png", site).href,
  ...(settings.phone && { telephone: settings.phone }),
  ...(settings.email && { email: settings.email }),
  ...(sameAs.length && { sameAs }),
  ...(founder && { founder: { "@type": "Person", name: founder } }),
  address: {
    "@type": "PostalAddress",
    addressLocality: settings.city,
    addressRegion: "QC",
    addressCountry: "CA",
  },
  areaServed: cities.map((c) => ({ "@type": "City", name: c })),
  ...(services.length && {
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Services informatiques pour PME",
      itemListElement: services.map((s) => ({
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: s.title,
          url: new URL(`/services/${s.slug}/`, site).href,
        },
      })),
    },
  }),
  // AggregateRating seulement si le nombre d'avis est connu (sinon invalide).
  ...(settings.google_reviews_count != null && {
    aggregateRating: {
      "@type": "AggregateRating",
      ratingValue: settings.google_rating.replace(",", "."),
      reviewCount: settings.google_reviews_count,
    },
  }),
};

const faqPage = faq.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faq.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    }
  : null;
---

<script type="application/ld+json" set:html={JSON.stringify(business)} is:inline />
{faqPage && (
  <script type="application/ld+json" set:html={JSON.stringify(faqPage)} is:inline />
)}
{extra.map((block) => (
  <script type="application/ld+json" set:html={JSON.stringify(block)} is:inline />
))}
