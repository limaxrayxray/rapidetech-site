---
// Guide (contenu d'entreprise long) — collection Directus `guides`.
// SEO : Article + BreadcrumbList (JSON-LD), FAQPage via le layout, lien
// croisé vers le service lié. Zéro JS.
import Base from "@/layouts/Base.astro";
import RichText from "@/components/RichText.astro";
import { getAbout, getGuides, getHome, getServices, getSiteSettings } from "@/lib/directus";
import { businessId } from "@/lib/schema";

export async function getStaticPaths() {
  const guides = await getGuides();
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props;
const [home, settings, about, services] = await Promise.all([
  getHome(),
  getSiteSettings(),
  getAbout(),
  getServices(),
]);
const service = services.find((s) => s.slug === guide.related_service) ?? null;

const site = Astro.site!;
const pageUrl = new URL(`/guides/${guide.slug}/`, site).href;
const indexUrl = new URL("/guides/", site).href;
const title = guide.seo_title || `${guide.title} | ${settings.company_name}`;
const description = guide.seo_description || guide.summary;
const updated = guide.date_updated || guide.date_created;
const updatedLabel = updated
  ? new Date(updated).toLocaleDateString("fr-CA", { day: "numeric", month: "long", year: "numeric" })
  : null;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: guide.title,
    description,
    inLanguage: "fr-CA",
    mainEntityOfPage: pageUrl,
    ...(guide.date_created && { datePublished: guide.date_created }),
    ...(updated && { dateModified: updated }),
    author: { "@type": "Person", name: about.name },
    publisher: { "@id": businessId(site) },
    image: new URL("/og.png", site).href,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: settings.company_name, item: site.href },
      { "@type": "ListItem", position: 2, name: home.guides_title, item: indexUrl },
      { "@type": "ListItem", position: 3, name: guide.title, item: pageUrl },
    ],
  },
];
---

<Base title={title} description={description} faq={guide.faq ?? []} jsonLd={jsonLd} ogType="article">
  <main class="rt-guide">
    <nav class="rt-crumbs" aria-label="Fil d'Ariane">
      <a href="/">← {settings.company_name}</a>
      <span aria-hidden="true">/</span>
      <a href="/guides/">{home.guides_title}</a>
    </nav>

    <article>
      <p class="rt-guide-eyebrow">
        / {home.guides_title}
        {updatedLabel && <Fragment> · <time datetime={updated}>{updatedLabel}</time></Fragment>}
      </p>
      <h1 class="rt-guide-title">{guide.title}</h1>
      {guide.summary && <p class="rt-guide-lede">{guide.summary}</p>}

      <RichText body={guide.body} />

      {guide.faq && guide.faq.length > 0 && (
        <section class="rt-guide-faq" aria-labelledby="guide-faq-title">
          <h2 id="guide-faq-title">{home.faq_title}</h2>
          {guide.faq.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </section>
      )}
    </article>

    <aside class="rt-guide-next">
      {service && (
        <a class="rt-guide-service" href={`/services/${service.slug}/`}>
          <span class="rt-guide-service-k">/ Service</span>
          <span class="rt-guide-service-t">{service.title} <span aria-hidden="true">→</span></span>
          <span class="rt-guide-service-d">{service.description}</span>
        </a>
      )}
      <div class="rt-guide-cta">
        <p class="rt-guide-cta-title">{home.cta_final_title}</p>
        <a href={home.cta_final_href}>{home.cta_final_label} <span aria-hidden="true">→</span></a>
      </div>
    </aside>
  </main>
</Base>

<style>
  .rt-guide {
    position: relative;
    z-index: 2;
    padding: var(--section-pad);
    max-width: 980px;
  }
  .rt-crumbs {
    margin-bottom: 48px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
  .rt-crumbs a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--dur-fast);
  }
  .rt-crumbs a:hover {
    color: var(--text-primary);
  }
  .rt-guide-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 20px;
  }
  .rt-guide-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(34px, 4.4vw, 64px);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    color: var(--text-primary);
    margin: 0 0 24px;
  }
  .rt-guide-lede {
    font-family: var(--font-body);
    font-size: var(--text-heading);
    line-height: 1.45;
    color: var(--text-primary);
    max-width: 760px;
    margin: 0 0 40px;
  }
  .rt-guide-faq {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--border-default);
    max-width: 720px;
  }
  .rt-guide-faq h2 {
    margin: 0 0 18px;
    font-family: var(--font-display);
    font-size: var(--text-heading);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .rt-guide-faq details {
    border-bottom: 1px solid var(--border-default);
    padding: 16px 0;
  }
  .rt-guide-faq summary {
    cursor: pointer;
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--text-primary);
  }
  .rt-guide-faq p {
    margin: 12px 0 0;
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
    color: var(--text-secondary);
  }
  .rt-guide-next {
    margin-top: 72px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--border-default);
    border: 1px solid var(--border-default);
  }
  .rt-guide-service,
  .rt-guide-cta {
    background: var(--surface-card);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .rt-guide-service {
    text-decoration: none;
    transition: background var(--dur-fast);
  }
  .rt-guide-service:hover {
    background: var(--surface-raised);
  }
  .rt-guide-service-k {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
  }
  .rt-guide-service-t {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-heading);
    text-transform: uppercase;
    color: var(--text-primary);
  }
  .rt-guide-service-d {
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    line-height: var(--leading-desc);
    color: var(--text-secondary);
  }
  .rt-guide-cta-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-heading);
    text-transform: uppercase;
    color: var(--text-primary);
    margin: 0;
  }
  .rt-guide-cta a {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
  }
  .rt-guide-cta a:hover {
    color: var(--text-primary);
  }
  @media (max-width: 720px) {
    .rt-guide-next {
      grid-template-columns: 1fr;
    }
  }
</style>
